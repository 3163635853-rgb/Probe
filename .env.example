# App
APP_NAME=Probe
DEBUG=false

# Database
DATABASE_URL=mysql+asyncmy://probe:probe_password@mysql:3306/probe
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=probe_password

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=your-jwt-secret-change-me

# LLM (OpenAI 兼容接口)
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
DEEPSEEK_MODEL=mimo-v2-pro

# WeChat
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret

# CORS (逗号分隔)
CORS_ORIGINS=https://probe.app,https://www.probe.app
