# App
APP_NAME=Probe
DEBUG=false

# Database
DATABASE_URL=mysql+aiomysql://probe:probe_password@mysql:3306/probe
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=probe_password

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=your-jwt-secret-change-me

# LLM (OpenAI 兼容接口)
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
DEEPSEEK_MODEL=mimo-v2-pro

# WeChat
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret

# CORS (逗号分隔)
CORS_ORIGINS=https://probe.app,https://www.probe.app

# WeChat Pay API v3
WECHAT_PAY_MCH_ID=your-merchant-id
WECHAT_PAY_MCH_SERIAL_NO=your-merchant-certificate-serial
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_your-wechat-pay-public-key-id
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechat/wechatpay_public_key.pem
WECHAT_PAY_API_V3_KEY=your-32-byte-api-v3-key
WECHAT_PAY_NOTIFY_URL=https://api.probe.app/api/payment/webhook

# Public URLs and share image storage
PUBLIC_API_URL=https://api.probe.app
PUBLIC_WEB_URL=https://probe.app
SHARE_STORAGE_DIR=/app/data/share_images
SHARE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
UPLOAD_STORAGE_DIR=/app/data/uploads
