{
  "expo": {
    "name": "Probe",
    "slug": "probe",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "probe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.probe.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#d97706",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.probe.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Probe需要麦克风权限来录制语音回答"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fafaf9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Probe需要访问相册以选择面试视频",
          "cameraPermission": "Probe需要使用摄像头录制模拟面试视频",
          "microphonePermission": "Probe需要使用麦克风录制面试回答"
        }
      ]
    ]
  }
}
