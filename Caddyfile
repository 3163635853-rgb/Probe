api.probe.app {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	# Backward compatibility: legacy App builds called /auth, /interview, etc.
	handle {
		rewrite * /api{uri}
		reverse_proxy backend:8000
	}
}

probe.app {
	reverse_proxy web:3000
}

# 本地开发用（不走域名时）
:80 {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
